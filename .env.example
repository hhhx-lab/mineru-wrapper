MINERU_API_BASE_URL=http://127.0.0.1:8000
WRAPPER_PUBLIC_BASE_URL=http://100.64.0.2:8100
REDIS_URL=redis://127.0.0.1:6379/0
WRAPPER_AUTH_TOKEN=change-me
DOWNLOAD_SIGNING_SECRET=change-me

RESULT_DIR=/app/data/results
TMP_DIR=/app/data/tmp

MINERU_BACKEND=hybrid-auto-engine
MINERU_PARSE_METHOD=auto
MINERU_LANG_LIST=ch
MINERU_FORMULA_ENABLE=true
MINERU_TABLE_ENABLE=true
MINERU_IMAGE_ANALYSIS=true
MINERU_RETURN_IMAGES=true

MINERU_MAX_ATTEMPTS=3
MINERU_TASK_TIMEOUT_SECONDS=3600
MINERU_POLL_INTERVAL_SECONDS=5
MINERU_DOWNLOAD_TIMEOUT_SECONDS=600
MINERU_RESULT_TTL_HOURS=72
SIGNED_URL_TTL_SECONDS=7200
MAX_DOWNLOAD_BYTES=524288000

ARTIFACT_DOWNLOAD_TTL_HOURS=6
ARTIFACT_DONE_TTL_HOURS=24
ARTIFACT_CLEANUP_INTERVAL_SECONDS=300

REQUEST_TRUST_ENV=false
CELERY_WORKER_CONCURRENCY=1
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=100.64.0.0/10,localhost,127.0.0.1
